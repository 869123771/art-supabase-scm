{
  "name": "@art-supabase/scm-module",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.28.2"
  },
  "description": "亿企工场的 SCM 供应链管理应用",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit --pretty false && vite build",
    "preview": "vite preview",
    "boundary:audit": "tsx scripts/audit-module-boundary.ts",
    "ui:audit": "tsx node_modules/art-supabase-pro/scripts/ui-audit.ts",
    "lint": "eslint \"src/**/*.{ts,vue}\" \"scripts/**/*.ts\" vite.config.ts",
    "typecheck": "vue-tsc --noEmit --pretty false",
    "test:unit": "tsx --test \"src/**/*.test.ts\"",
    "check": "pnpm boundary:audit && pnpm ui:audit && pnpm typecheck && pnpm lint && pnpm test:unit"
  },
  "dependencies": {
    "art-supabase-pro": "https://github.com/869123771/art-supabase-pro/archive/6ccf889be87b7d0b400a8a1b793ca8d8c9b3cd9d.tar.gz"
  },
  "peerDependencies": {
    "lodash-es": "^4.18.1",
    "vue": "^3.5.43",
    "element-plus": "^2.14.7",
    "pinia": "4.0.3",
    "vue-router": "^5.4.0",
    "dayjs": "^1.11.23"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash-es": "4.17.12",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/compiler-sfc": "3.5.43",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.3",
    "vue-tsc": "~3.3.12"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/wangyanghub/art-supabase-scm.git"
  },
  "license": "MulanPSL-2.0"
}
